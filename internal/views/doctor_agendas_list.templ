package views

import (
    "fmt"
    "github.com/gattini0928/Equilibrium/internal/models"
  )

templ DoctorAgendasList(p models.DoctorDashboard) {
	for _, agenda := range p.Agendas {
		<div class="schedule-list">
			<div class="schedule-item">
				<span class="date">
					<span>{agenda.Date.Format("02/01/2006 15:04")}</span>
				</span>
				<form method="POST" hx-post={ templ.URL(fmt.Sprintf("/me/agenda/%d", agenda.ID)) } hx-target="#agendas-list" hx-swap="outerHTML">
					<button type="submit">Deletar</button>
				</form>
			</div>
		</div>
	}
}